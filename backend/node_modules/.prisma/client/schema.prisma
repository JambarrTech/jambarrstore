datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String   @unique
  password  String
  role      String   @default("CLIENT") // CLIENT, ADMIN, MANAGER
  createdAt DateTime @default(now())
}

model Category {
  id           String    @id @default(uuid())
  name         String    @unique
  icon         String?
  productCount Int       @default(0)
  products     Product[]
}

model Product {
  id          String      @id @default(uuid())
  name        String
  reference   String      @unique
  price       Float
  oldPrice    Float?
  stock       Int         @default(0)
  imageUrl    String
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  isFeatured  Boolean     @default(false)
  isFlash     Boolean     @default(false)
  description String?
  orderItems  OrderItem[]
  reviews     Review[]
  createdAt   DateTime    @default(now())
}

model Order {
  id            String      @id @default(uuid())
  reference     String      @unique
  clientName    String
  clientPhone   String?
  clientAddress String?
  totalAmount   Float
  status        String      @default("PENDING") // PENDING, PROCESSING, DELIVERED, CANCELLED
  paymentMethod String // Wave, Orange Money
  paymentStatus String      @default("PAID")
  items         OrderItem[]
  createdAt     DateTime    @default(now())
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model Review {
  id         String   @id @default(uuid())
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])
  clientName String
  rating     Int      @default(5)
  comment    String
  status     String   @default("pending") // pending, approved
  createdAt  DateTime @default(now())
}

model PaymentTransaction {
  id         String   @id @default(uuid())
  reference  String   @unique
  orderId    String?
  clientName String
  amount     Float
  method     String // Wave, Orange Money
  status     String   @default("Réussi")
  createdAt  DateTime @default(now())
}

model Promotion {
  id              String   @id @default(uuid())
  title           String
  discountPercent Int
  targetCategory  String
  startDate       String?
  endDate         String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(uuid())
  action    String
  user      String
  module    String
  ipAddress String?
  result    String   @default("SUCCÈS")
  createdAt DateTime @default(now())
}

model Settings {
  id             String  @id @default("settings")
  storeName      String  @default("JambarrTech")
  storeEmail     String  @default("contact@jambarrtech.com")
  phone          String  @default("+221 77 123 45 67")
  address        String  @default("Dakar, Sénégal")
  logoUrl        String?
  commissionRate Float   @default(5.0)
  minCommission  Float   @default(500)
}
