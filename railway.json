{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd packages/shared && npx prisma generate && cd ../../services/api && npm install"
  },
  "deploy": {
    "startCommand": "cd services/api && node --import tsx src/server.ts",
    "healthcheckPath": "/api/products",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
